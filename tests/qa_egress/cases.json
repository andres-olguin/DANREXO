[
  {
    "id": "mask-email",
    "messages": [
      {"role": "system", "content": "Responde en español."},
      {"role": "user", "content": "Correo ficticio: qa-sandbox@example.invalid"}
    ],
    "expected_action": "forward",
    "expected_contents": ["Responde en español.", "Correo ficticio: [[EMAIL]]"],
    "expected_spans": [[], [{"type": "EMAIL", "start": 17, "end": 43}]]
  },
  {
    "id": "block-sentinel",
    "messages": [
      {"role": "user", "content": "PROMPT_BLOCK_TEST"}
    ],
    "expected_action": "block",
    "expected_contents": null,
    "expected_spans": [[]]
  },
  {
    "id": "preserve-clean-text",
    "messages": [
      {"role": "user", "content": "Resumen de la reunión del equipo."}
    ],
    "expected_action": "forward",
    "expected_contents": ["Resumen de la reunión del equipo."],
    "expected_spans": [[]]
  },
  {
    "id": "cl-rut",
    "messages": [
      {"role": "user", "content": "Chile: RUT 12.345.678-5"}
    ],
    "expected_action": "forward",
    "expected_contents": ["Chile: RUT [[RUT]]"],
    "expected_spans": [[{"type": "RUT", "start": 11, "end": 23}]]
  },
  {
    "id": "mx-curp-json-list",
    "messages": [
      {"role": "user", "content": "{\"datos\":[{\"curp\":\"FAXQ781106MBCVRL28\"},\"México\"]}"}
    ],
    "expected_action": "forward",
    "expected_contents": ["{\"datos\":[{\"curp\":\"[[CURP]]\"},\"México\"]}"],
    "expected_spans": [[{"type": "CURP", "start": 19, "end": 37}]]
  },
  {
    "id": "bo-ci-unicode",
