    "expected_action": "forward",
    "expected_contents": ["📋 CÉDULA BOLIVIANA: [[CI_BO]]"],
    "expected_spans": [[{"type": "CI_BO", "start": 20, "end": 28}]]
  },
  {
    "id": "co-cedula",
    "messages": [
      {"role": "user", "content": "Colombia: cédula 52123456"}
    ],
    "expected_action": "forward",
