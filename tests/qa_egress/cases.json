      {"role": "user", "content": "RUT 12.345.678-0; CURP: FAXQ781332MBCVRL28."}
    ],
    "expected_action": "forward",
    "expected_contents": ["RUT 12.345.678-0; CURP: FAXQ781332MBCVRL28."],
    "expected_spans": [[]]
  },
